{
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build": "remix build",
    "dev": "remix dev",
    "start": "remix-serve build",
    "format": "prettier --write ./app",
    "typecheck": "tsc -b",
    "cerbos": "cerbos server --config ./cerbos/config.yaml",
    "cerbos:docker": "docker run --rm --name cerbos -it -v $(pwd)/cerbos/policies:/policies -p 3592:3592 -p 3593:3593  ghcr.io/cerbos/cerbos:0.26.0",
    "cerbos:docker:win": "docker run --rm --name cerbos -it -v  %cd%/cerbos/policies:/policies -p 3592:3592 -p 3593:3593  ghcr.io/cerbos/cerbos:0.26.0"
  },
  "dependencies": {
    "@cerbos/grpc": "^0.29.0",
    "@clerk/remix": "^4.13.43",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "classnames": "^2.5.1",
    "isbot": "^5.1.44",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "@remix-run/eslint-config": "^2.17.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^8.57.1",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module"
}
